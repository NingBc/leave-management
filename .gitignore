# --- 后端 (Spring Boot) ---
backend/target/
backend/.mvn/
backend/mvnw
backend/mvnw.cmd
backend/*.class
backend/.idea/
backend/*.iml

# --- 前端 (Vue + Vite) ---
frontend/node_modules/
frontend/dist/
frontend/.vscode/
frontend/.DS_Store
frontend/src/assets/logo.png
frontend/public/favicon_base.jpg

# --- 敏感信息与配置 ---
**/application.local.yml
**/.env
**/config/secrets.properties
**/secrets/

# --- 运行日志 ---
# 每次跑应用或测试都会改动这些文件, 纳入版本管理会让切分支/合并频繁被挡
logs/
backend/logs/

# --- IDE ---
# .idea/compiler.xml 曾经是唯一让 Lombok 生效的地方(IDE 构建正常、Maven 构建产物全废)。
# 现在 pom 里已显式声明 annotationProcessorPaths, IDE 配置不再是构建的必要条件, 可以安全忽略。
.idea/

# --- 系统文件 ---
.DS_Store
Thumbs.db
.vscode/
