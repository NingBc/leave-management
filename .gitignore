# --- 后端 (Spring Boot) ---
backend/target/
backend/.mvn/
backend/mvnw
backend/mvnw.cmd
backend/*.class
backend/.idea/
backend/*.iml

# --- 前端 (Vue + Vite) ---
frontend/node_modules/
frontend/dist/
# 前端构建产物, 由 build_all_in_one.sh 生成后拷进来。
# Vite 的文件名带内容哈希, 纳入版本管理会让每次前端改动都产生大片增删,
# 而且极易忘记重建 —— 曾经出现过 static 停留在 2026-02 而源码已改到 08 月的脱节。
# 注意: 发版必须走 build_all_in_one.sh; 单独跑 mvn package 得到的 jar 不含前端。
backend/src/main/resources/static/
frontend/.vscode/
frontend/.DS_Store
frontend/src/assets/logo.png
frontend/public/favicon_base.jpg

# --- 敏感信息与配置 ---
**/application.local.yml
**/.env
**/config/secrets.properties
**/secrets/

# --- 运行日志 ---
# 每次跑应用或测试都会改动这些文件, 纳入版本管理会让切分支/合并频繁被挡
logs/
backend/logs/

# --- IDE ---
# .idea/compiler.xml 曾经是唯一让 Lombok 生效的地方(IDE 构建正常、Maven 构建产物全废)。
# 现在 pom 里已显式声明 annotationProcessorPaths, IDE 配置不再是构建的必要条件, 可以安全忽略。
.idea/

# --- 系统文件 ---
.DS_Store
Thumbs.db
.vscode/
